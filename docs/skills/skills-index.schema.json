{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capability Registry v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "contract_version",
    "description",
    "schema_refs",
    "categories",
    "packages",
    "capabilities"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 3},
    "contract_version": {"const": "capability-registry/3"},
    "description": {"type": "string", "minLength": 1},
    "schema_refs": {"$ref": "#/$defs/schemaRefs"},
    "categories": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/category"},
      "propertyNames": {"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/package"}
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/capability"}
    }
  },
  "$defs": {
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "possiblyEmptyStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "symbolicScopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!.*\\.\\.)(?!.*[/\\\\~:])[A-Za-z0-9][A-Za-z0-9._-]*$"
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": [
        "filesystem-read", "filesystem-write", "source-write", "artifact-write",
        "git-read", "git-write", "command-runner", "browser-control", "client-control",
        "visual-evidence", "external-provider", "text-authoring"
      ]}
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": [
        "read-repository", "read-git-state", "read-source", "write-source", "write-artifact", "write-run-local-cache",
        "write-git-state", "control-browser-state", "control-client-state",
        "invoke-external-provider", "emit-findings", "emit-handoff", "emit-draft"
      ]}
    },
    "stopStates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "mutationClass": {"enum": [
      "read-only", "artifact-write", "source-write", "git-write",
      "browser-control", "client-control", "external-action"
    ]},
    "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "schemaRef": {
      "type": "string",
      "pattern": "^urn:[a-z0-9][a-z0-9.-]*(?::[a-z0-9][a-z0-9.-]*)?:v[0-9]+$"
    },
    "schemaRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared_portable", "known_local"],
      "properties": {
        "declared_portable": {
          "type": "array", "uniqueItems": true, "minItems": 1,
          "items": {"$ref": "#/$defs/schemaRef"}
        },
        "known_local": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/schemaRef"}
        }
      }
    },
    "schemaInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "kind"],
      "properties": {
        "schema": {"$ref": "#/$defs/schemaRef"},
        "kind": {"enum": ["portable", "local"]},
        "stage": {"type": "string", "minLength": 1}
      }
    },
    "failureCode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "recoverable", "recovery"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
        "recoverable": {"type": "boolean"},
        "recovery": {"type": "string", "minLength": 1}
      }
    },
    "adapterBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "portable_fields_forbidden"],
      "properties": {
        "policy": {"const": "runtime-only"},
        "portable_fields_forbidden": {
          "type": "array", "uniqueItems": true, "minItems": 1,
          "items": {"enum": ["provider", "model", "cli_path", "executable"]}
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "category", "owner", "mutation_class", "required_capabilities",
        "allowed_effects", "forbidden_effects", "stop_states", "intents", "keywords",
        "excludes", "related", "capability_ids"
      ],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "category": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "owner": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "mutation_class": {"$ref": "#/$defs/mutationClass"},
        "required_capabilities": {"$ref": "#/$defs/capabilities"},
        "allowed_effects": {"$ref": "#/$defs/effects"},
        "forbidden_effects": {"$ref": "#/$defs/effects"},
        "stop_states": {"$ref": "#/$defs/stopStates"},
        "intents": {"$ref": "#/$defs/nonEmptyStrings"},
        "keywords": {"$ref": "#/$defs/nonEmptyStrings"},
        "excludes": {"$ref": "#/$defs/nonEmptyStrings"},
        "related": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
        },
        "capability_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"}
        }
      }
    },
    "permissionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_mutation_class", "maximum_effects", "forbidden_effects",
        "required_confirmations", "symbolic_scope_constraints"
      ],
      "properties": {
        "maximum_mutation_class": {"$ref": "#/$defs/mutationClass"},
        "maximum_effects": {"$ref": "#/$defs/effects"},
        "forbidden_effects": {"$ref": "#/$defs/effects"},
        "required_confirmations": {"$ref": "#/$defs/possiblyEmptyStrings"},
        "symbolic_scope_constraints": {"$ref": "#/$defs/symbolicScopes"}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id", "capability_version", "package", "description", "accepts", "produces",
        "preconditions", "postconditions", "permission_contract", "failure_codes",
        "evidence_requirements", "adapter_binding"
      ],
      "properties": {
        "capability_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "capability_version": {"$ref": "#/$defs/semver"},
        "package": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "description": {"type": "string", "minLength": 1},
        "accepts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/schemaInput"}},
        "produces": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/schemaInput"}},
        "preconditions": {"$ref": "#/$defs/nonEmptyStrings"},
        "postconditions": {"$ref": "#/$defs/nonEmptyStrings"},
        "permission_contract": {"$ref": "#/$defs/permissionContract"},
        "failure_codes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/failureCode"}},
        "evidence_requirements": {"$ref": "#/$defs/nonEmptyStrings"},
        "adapter_binding": {"$ref": "#/$defs/adapterBinding"}
      }
    }
  }
}
