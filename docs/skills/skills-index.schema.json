{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill discovery and execution contract index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "description",
    "categories",
    "skills"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 2
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "categories": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/category"
      },
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/skill"
      }
    }
  },
  "$defs": {
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "filesystem-read",
          "filesystem-write",
          "source-write",
          "artifact-write",
          "git-read",
          "git-write",
          "command-runner",
          "browser-control",
          "client-control",
          "visual-evidence",
          "external-provider",
          "text-authoring"
        ]
      }
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "read-repository",
          "read-git-state",
          "read-source",
          "write-source",
          "write-artifact",
          "write-git-state",
          "control-browser-state",
          "control-client-state",
          "invoke-external-provider",
          "emit-findings",
          "emit-handoff",
          "emit-draft"
        ]
      }
    },
    "stopStates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "category",
        "owner",
        "mutation_class",
        "required_capabilities",
        "allowed_effects",
        "forbidden_effects",
        "stop_states",
        "intents",
        "keywords",
        "excludes",
        "related"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "category": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "owner": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "mutation_class": {
          "enum": [
            "read-only",
            "artifact-write",
            "source-write",
            "git-write",
            "browser-control",
            "client-control",
            "external-action"
          ]
        },
        "required_capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "allowed_effects": {
          "$ref": "#/$defs/effects"
        },
        "forbidden_effects": {
          "$ref": "#/$defs/effects"
        },
        "stop_states": {
          "$ref": "#/$defs/stopStates"
        },
        "intents": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "keywords": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "excludes": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "related": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    }
  }
}
